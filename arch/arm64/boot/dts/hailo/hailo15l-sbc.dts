/dts-v1/;
#include "hailo15l-base.dtsi"
#include "dt-bindings/net/mscc-phy-vsc8531.h"

/ {
    model = "Hailo - Hailo15l SBC VPU Development Board";
};

&i2c_0 {
    status = "okay";
    /* @note I2C-BUS-0 SCL,SDA pads are non-muxable pins */
    i2c-sda-falling-time-ns = <1000>;
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_i2c0_scl>, <&pinctrl_i2c0_sda>;
};

&i2c_1 {
    status = "okay";
    i2c-sda-falling-time-ns = <1000>;
    /* @note I2C-BUS-1 SCL,SDA pads are non-muxable pins */
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_i2c1_scl>, <&pinctrl_i2c1_sda>;
    /* @todo - M.2 Ekey, clock buffer, DSI */
    codec_tlv320aic3104: tlv320aic3104@18 {
        #sound-dai-cells = <0>;
        compatible = "ti,tlv320aic3104";
        reg = <0x18>;
        /* @note, If using I2S Controller mode as:
         * - Master: set: ai3x-source-clk = "bclk";
         * - Slave: set: ai3x-source-clk = "mclk";
         */

        ai3x-source-clk = "bclk";
        ai3x-micbias-vg = <2>;
		/* Regulators */
		AVDD-supply = <&regulator_3p3v>;
		IOVDD-supply = <&regulator_1p8v>;
		DRVDD-supply = <&regulator_3p3v>;
		DVDD-supply = <&regulator_1p8v>;
    };

    ina231_1v8: 1v8@40 {
        compatible = "ti,ina231_precise";
        reg = <0x40>;
        shunt-resistor = <100000>;
        max-current = <1000>;
    };
    ina231_0v8: 0v8@41 {
        compatible = "ti,ina231_precise";
        reg = <0x41>;
        shunt-resistor = <1000>;
        max-current = <10000>;
    };
    ina231_VDDQX_DRAM: 1v1@42 {
        compatible = "ti,ina231_precise";
        reg = <0x42>;
        shunt-resistor = <5000>;
        max-current = <300>;
    };
    ina231_3v3: 3v3@44 {
        compatible = "ti,ina231_precise";
        reg = <0x44>;
        shunt-resistor = <100000>;
        max-current = <300>;
    };
    ina231_VDDQX_SOC: 1v1@46 {
        compatible = "ti,ina231_precise";
        reg = <0x46>;
        shunt-resistor = <100000>;
        max-current = <20>;
    };
    ina231_VDDQ_SOC: 0v6@47 {
        compatible = "ti,ina231_precise";
        reg = <0x47>;
        shunt-resistor = <12000>;
        max-current = <62>;
    };
    ina231_VDDQ_DRAM: 0v6@48 {
        compatible = "ti,ina231_precise";
        reg = <0x48>;
        shunt-resistor = <50000>;
        max-current = <27>;
    };
    ina231_VDD1_DRAM: 1v8@49 {
        compatible = "ti,ina231_precise";
        reg = <0x49>;
        shunt-resistor = <100000>;
        max-current = <10>;
    };

    tmp175_NEAR_H15_SOC: NEAR_H15_SOC@2c {
        compatible = "ti,tmp175";
        reg = <0x2c>;
    };

    regulator_0p8v: regulator-0p8v@43 {
        status = "disabled";
        compatible = "ti,tps62872";
        reg = <0x43>;
        regulator-name = "+0.8V";
        regulator-min-microvolt = <400000>;
        regulator-max-microvolt = <1037500>;
        regulator-initial-mode = <2>;
    };

    lcd@45 {
        status = "disabled";
        compatible = "raspberrypi,7inch-touchscreen-panel";
        reg = <0x45>;
        port {
            panel_in: endpoint {
                remote-endpoint = <&dsi0_out>;
            };
        };
    };
};

&i2c_2 {
    status = "ok";
    clock-frequency = <400000>;
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_gpio_16>, <&pinctrl_gpio_17>;
    i2c-sda-falling-time-ns = <190>;

    gyro_lsm6dsr_2: lsm6dsr_2@6a {
        compatible = "st,lsm6dsr";
        reg = <0x6a>;
        vdd-supply = <&regulator_1p8v>;
        vddio-supply = <&regulator_1p8v>;
        interrupt-parent = <&gpio1>;
        interrupts = <11 IRQ_TYPE_LEVEL_HIGH>;
        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_gpio_27>;
    };
};

&serial0 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_uart0_txd>, <&pinctrl_uart0_rxd>;
};

&serial1 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_uart1_txd>, <&pinctrl_uart1_rxd>;
};

&eth {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_eth_mdc>,
                <&pinctrl_eth_mdio>,
                <&pinctrl_eth_rx_clk>,
                <&pinctrl_eth_rx_ctl_dv>,
                <&pinctrl_eth_rxd0>,
                <&pinctrl_eth_rxd1>,
                <&pinctrl_eth_rxd2>,
                <&pinctrl_eth_rxd3>,
                <&pinctrl_eth_tx_clk>,
                <&pinctrl_eth_tx_ctl_en>,
                <&pinctrl_eth_txd_0>,
                <&pinctrl_eth_txd_1>,
                <&pinctrl_eth_txd_2>,
                <&pinctrl_eth_txd_3>;
    phy-handle = <&vsc8531_0>;
    #address-cells = <1>;
    #size-cells = <0>;
    vsc8531_0: ethernet-phy@0 {
        reg = <0>;
        compatible = "ethernet-phy-id0007.0570";
        // Set recommended edge-slowdown for vddmac 1.8V (from mscc-phy-vsc8531.txt)
        vsc8531,vddmac = <1800>;
        vsc8531,edge-slowdown = <16>;
        vsc8531,rx-clk-skew = <VSC8531_RGMII_CLK_DELAY_1_7_NS>;
        vsc8531,tx-clk-skew = <VSC8531_RGMII_CLK_DELAY_1_7_NS>;
        vsc8531,led-0-mode = <VSC8531_LINK_1000_ACTIVITY>;
        vsc8531,led-1-mode = <VSC8531_LINK_100_ACTIVITY>;
    };
};

&sdio0_reserved {
    status = "okay";
};

&sdio0 {
    status = "okay";
    sdhci-caps = <0 0x01000000>; // Force VOLT33 capability
    sdhci-caps-mask = <0x00000002 0x00000000>;  // Disable support for SDR104
    bus-width = <4>;
    phy-config {
            card-is-emmc = <0x0>;
            cmd-pad-values = <0x1 0x3 0x1 0x1>; // txslew_ctrl_n, txslew_ctrl_p, weakpull_enable, rxsel
            dat-pad-values = <0x1 0x3 0x1 0x1>; // txslew_ctrl_n, txslew_ctrl_p, weakpull_enable, rxsel
            rst-pad-values = <0x1 0x3 0x1 0x1>; // txslew_ctrl_n, txslew_ctrl_p, weakpull_enable, rxsel
            clk-pad-values = <0x1 0x3 0x0 0x1>; // txslew_ctrl_n, txslew_ctrl_p, weakpull_enable, rxsel
            sdclkdl-cnfg = <0x0 0x50>; //extdly_en, cckdl_dc
            drive-strength = <0xC 0xC>; //pad_sp, pad_sn
    };
};

&sdio1 {
    status = "okay";
    non-removable;
    phy-config {
            card-is-emmc = <0x1>;
            cmd-pad-values = <0x2 0x2 0x1 0x1>; // txslew_ctrl_n, txslew_ctrl_p, weakpull_enable, rxsel
            dat-pad-values = <0x2 0x2 0x1 0x1>; // txslew_ctrl_n, txslew_ctrl_p, weakpull_enable, rxsel
            rst-pad-values = <0x2 0x2 0x1 0x1>; // txslew_ctrl_n, txslew_ctrl_p, weakpull_enable, rxsel
            clk-pad-values = <0x2 0x2 0x0 0x0>; // txslew_ctrl_n, txslew_ctrl_p, weakpull_enable, rxsel
            sdclkdl-cnfg = <0x0 0x64>; //extdly_en, cckdl_dc
            drive-strength = <0xA 0xA>; //pad_sp, pad_sn
            u-boot,dm-spl;
    };
};

&i2s_hailo {
    status = "okay";
    i2s_0_cpu: audio-controller-0@10d000 {
        status = "okay";
        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_i2s0_sck>,
                    <&pinctrl_i2s0_sdi>,
                    <&pinctrl_i2s0_sdo>,
                    <&pinctrl_i2s0_ws>;
        /* Possible audio-controller configuration to override into you specific board DTS.
         * - Master:
         *   - set one of the following:
         *     - HAILO_I2S_CTRL_CFG(0, XTAL);
         *     - HAILO_I2S_CTRL_CFG(0, PCLK);
         *     - HAILO_I2S_CTRL_CFG(0, FAST_ACLK);
         *     - HAILO_I2S_CTRL_CFG(0, EXTERNAL_MCLK, <OSC Hz>); - E.g: OSC Hz: 12288000
         * - Slave:
         *   - set: HAILO_I2S_CTRL_CFG(0, SLAVE_CLK); - default
         */
         HAILO_I2S_CTRL_CFG(0, PCLK);
    };
};

&audio_card_0 {
    status = "okay";
    /* Possible audio-card configuration to override into you specific board DTS.
     * If using I2S Controller mode as:
     * - Masrer: set SIMPLE_AUDIO_CARD_CFG(0, MASTER);
     * - Slave: set SIMPLE_AUDIO_CARD_CFG(0, SLAVE);
     */
    SIMPLE_AUDIO_CARD_CFG(0, MASTER);
    cpu_dai_0: simple-audio-card,cpu {
        /* Possible CPU DAI configuration to override into you specific board DTS.
         * If using I2S Controller mode as:
         * - Maser: set CPU_DAI_CFG(0, MASTER);
         * - Slave: set CPU_DAI_CFG(0, SLAVE, <OSC Hz>); // OSC Hz is the external oscillator frequency E.g.: 12288000
         */
        CPU_DAI_CFG(0, MASTER);
    };
    codec_dai_0: simple-audio-card,codec {
        sound-dai = <&codec_tlv320aic3104>;
        /* Possible CODEC DAI configuration to override into you specific board DTS.
         * If using I2S Controller mode as:
         * - Master: set CODEC_DAI_CFG(0, MASTER);
         * - Slave: set: CODEC_DAI_CFG(0, SLAVE, <OSC Hz>); // OSC Hz is the external oscillator frequency E.g.: 12288000
         */
        CODEC_DAI_CFG(0, MASTER);
    };
};

&pwm {
    status = "okay";
    hailo15_pwm,supported-channels = <0 1>;
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_gpio_30>, <&pinctrl_gpio_31>;
};

&spi_0 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_gpio_20>,
                <&pinctrl_gpio_21>,
                <&pinctrl_gpio_22>,
                <&pinctrl_gpio_23>,
                <&pinctrl_gpio_24>,
                <&pinctrl_gpio_25>,
                <&pinctrl_gpio_26>;
    spi@0 {
        compatible = "spidev";
        reg = <0>;
        spi-max-frequency = <100000>;
    };
};

&dpi0 {
    status = "disabled";
};

&dsi0 {
    status = "disabled";
    ports {
        port@0 {
            reg = <0>;
            dsi0_out: endpoint {
                remote-endpoint = <&panel_in>;
            };
        };
    };
};

&dphy0 {
    status = "disabled";
};


&hailo_torrent_phy {
    status = "okay";
    compatible = "hailo15l,torrent-phy";
    usb-lane = <1>;
    usb-lane-pma-pll-full-rate-divider = <PCI_PMA_PLL_FULL_RATE_CLK_DIVIDER_4>;
    lanes-config = <PCI_PHY_LINK_LANES_CFG__2x1_PLUS_1x2__MASTER_LANES_LN0_LN1_LN2>;
};

&cdns_torrent_phy {
    torrent_phy_pcie: phy@0 {
        reg = <0>;
        resets = <&scmi_reset HAILO15_SCMI_RESET_IDX_PCIE_PHY_LANE_0>;
        #phy-cells = <0>;
        cdns,phy-type = <PHY_TYPE_PCIE>;
        cdns,num-lanes = <1>;
    };
    torrent_phy_usb3: phy@1 {
        reg = <1>;
        resets = <&scmi_reset HAILO15_SCMI_RESET_IDX_PCIE_PHY_LANE_1>;
        #phy-cells = <0>;
        cdns,phy-type = <PHY_TYPE_USB3>;
        cdns,num-lanes = <1>;
        cdns,ssc-mode = <TORRENT_SERDES_NO_SSC>;
    };
};

&hailo_usb3 {
    status = "okay";
};

&cdns_usb3 {
    dr_mode = "host";
    phys = <&torrent_phy_usb3>;
    phy-names = "cdns3,usb3-phy";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_gpio_1>, <&pinctrl_usb_drive_vbus>;
};

&soc {
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_jtag_tck>,
                <&pinctrl_jtag_tdi>,
                <&pinctrl_jtag_tdo>,
                <&pinctrl_jtag_tms>,
                <&pinctrl_jtag_trstn_in>;
};

&spi0_flash0 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_flash_cs0_n>,
                <&pinctrl_flash_dq_0_mosi>,
                <&pinctrl_flash_dq_1_miso>,
                <&pinctrl_flash_dq_2>,
                <&pinctrl_flash_dq_3>,
                <&pinctrl_flash_sclk>;
};

&pinctrl {
    early-assignment-pin-groups =
        "uart0_rxd_in_0_grp",
        "uart0_txd_out_0_grp",
        "uart1_rxd_in_0_grp",
        "uart1_txd_out_0_grp",
        "flash_spi_dq_0_grp",
        "flash_spi_dq_1_grp",
        "flash_spi_dq_2_grp",
        "flash_spi_dq_3_grp",
        "flash_spi_sclk_out_grp",
	"jtag_tck_in_grp",
	"jtag_tdi_in_grp",
	"jtag_tdo_out_grp",
	"jtag_tms_grp",
	"jtag_trstn_in_grp";

    /* IO_PAD_0 */
    pinctrl_i2c0_scl: i2c0_scl {
        function = "i2c0_scl";
        groups = "i2c0_scl_0_grp";
        drive-strength = <8>;
    };

    /* IO_PAD_1 */
    pinctrl_i2c0_sda: i2c0_sda {
        function = "i2c0_sda";
        groups = "i2c0_sda_0_grp";
        drive-strength = <8>;
    };

    /* IO_PAD_2 */
    pinctrl_i2c1_scl: i2c1_scl {
        function = "i2c1_scl";
        groups = "i2c1_scl_0_grp";
        drive-strength = <8>;
    };

    /* IO_PAD_3 */
    pinctrl_i2c1_sda: i2c1_sda {
        function = "i2c1_sda";
        groups = "i2c1_sda_0_grp";
        drive-strength = <8>;
    };

    /* IO_PAD_4 */
    pinctrl_uart0_rxd: uart0_rxd {
        function = "uart0_rxd_in";
        groups = "uart0_rxd_in_0_grp";
    };

    /* IO_PAD_5 */
    pinctrl_uart0_txd: uart0_txd {
        function = "uart0_txd_out";
        groups = "uart0_txd_out_0_grp";
    };

    /* IO_PAD_6 */
    pinctrl_uart1_rxd: uart1_rxd {
        function = "uart1_rxd_in";
        groups = "uart1_rxd_in_0_grp";
    };

    /* IO_PAD_7 */
    pinctrl_uart1_txd: uart1_txd {
        function = "uart1_txd_out";
        groups = "uart1_txd_out_0_grp";
    };

    /* IO_PAD_8 */
    pinctrl_eth_mdc: eth_mdc_out {
        function = "eth_mdc_out";
        groups = "eth_mdc_out_grp";
    };

    /* IO_PAD_9 */
    pinctrl_eth_mdio: eth_mdio {
        function = "eth_mdio";
        groups = "eth_mdio_grp";
    };

    /* IO_PAD_10 */
    pinctrl_eth_rx_clk: eth_rx_clk_in {
        function = "eth_rx_clk_in";
        groups = "eth_rx_clk_in_grp";
    };

    /* IO_PAD_11 */
    pinctrl_eth_rx_ctl_dv: eth_rx_ctl_dv_in {
        function = "eth_rx_ctl_crs_dv_in";
        groups = "eth_rx_ctl_crs_dv_in_grp";
    };

    /* IO_PAD_12 */
    pinctrl_eth_rxd0: eth_rxd_0_in {
        function = "eth_rxd_0_in";
        groups = "eth_rxd_0_in_grp";
    };

    /* IO_PAD_13 */
    pinctrl_eth_rxd1: eth_rxd_1_in {
        function = "eth_rxd_1_in";
        groups = "eth_rxd_1_in_grp";
    };

    /* IO_PAD_14 */
    pinctrl_eth_rxd2: eth_rxd_2_in {
        function = "eth_rxd_2_in";
        groups = "eth_rxd_2_in_grp";
    };

    /* IO_PAD_15 */
    pinctrl_eth_rxd3: eth_rxd_3_er_in {
        function = "eth_rxd_3_er_in";
        groups = "eth_rxd_3_er_in_grp";
    };

    /* IO_PAD_16 */
    pinctrl_eth_tx_clk: eth_tx_clk {
        function = "eth_tx_clk_out";
        groups = "eth_tx_clk_out_grp";
        drive-strength = <12>;
    };

    /* IO_PAD_17 */
    pinctrl_eth_tx_ctl_en: eth_tx_ctl_en {
        function = "eth_tx_ctl_en_out";
        groups = "eth_tx_ctl_en_out_grp";
        drive-strength = <13>;
    };

    /* IO_PAD_18 */
    pinctrl_eth_txd_0: eth_txd_0 {
        function = "eth_txd_0_out";
        groups = "eth_txd_0_out_grp";
        drive-strength = <13>;
    };

    /* IO_PAD_19 */
    pinctrl_eth_txd_1: eth_txd_1 {
        function = "eth_txd_1_out";
        groups = "eth_txd_1_out_grp";
        drive-strength = <13>;
    };

    /* IO_PAD_20 */
    pinctrl_eth_txd_2: eth_txd_2 {
        function = "eth_txd_2_out";
        groups = "eth_txd_2_out_grp";
        drive-strength = <13>;
    };

    /* IO_PAD_21 */
    pinctrl_eth_txd_3: eth_txd_3 {
        function = "eth_txd_3_out";
        groups = "eth_txd_3_out_grp";
        drive-strength = <13>;
    };

    /* IO_PAD_22 */
    pinctrl_i2s0_sck: i2s0_sck {
        function = "i2s0_sck";
        groups = "i2s0_sck_0_grp";
    };

    /* IO_PAD_23 */
    pinctrl_i2s0_sdi: i2s0_sdi0 {
        function = "i2s0_sdi0_in";
        groups = "i2s0_sdi0_in_0_grp";
    };

    /* IO_PAD_24 */
    pinctrl_i2s0_sdo: i2s0_sdo0 {
        function = "i2s0_sdo0_out";
        groups = "i2s0_sdo0_out_0_grp";
        drive-strength = <8>;
    };

    /* IO_PAD_25 */
    pinctrl_i2s0_ws: i2s0_ws {
        function = "i2s0_ws";
        groups = "i2s0_ws_0_grp";
    };

    /* IO_PAD_26 */
	pinctrl_flash_cs0_n: flash_cs0_n_out {
	    function = "flash_spi_cs_0_n_out";
        groups = "flash_spi_cs_0_n_out_grp";
    };

    /* IO_PAD_27 */
    pinctrl_flash_cs1_n: flash_cs1_n_out {
	    function = "flash_spi_cs_1_n_out";
        groups = "flash_spi_cs_1_n_out_grp";
    };

    /* IO_PAD_28 */
    pinctrl_flash_cs2_n: flash_cs2_n_out {
	    function = "flash_spi_cs2n_clkc_rebar_out";
        groups = "flash_spi_cs2n_clkc_rebar_out_grp";
    };

    /* IO_PAD_29 - In SBC, flash_ds pin is serving as gpio function, and not connected to any external function */
    pinctrl_flash_ds: flash_ds_in {
	    function = "gpio5";
        groups = "gpio5_1_grp";
    };

    /* IO_PAD_30 */
    pinctrl_flash_dq_0_mosi: flash_dq_0_mosi_in {
	    function = "flash_spi_dq_0";
        groups = "flash_spi_dq_0_grp";
    };

    /* IO_PAD_31 */
    pinctrl_flash_dq_1_miso: flash_dq_1_miso_in {
	    function = "flash_spi_dq_1";
        groups = "flash_spi_dq_1_grp";
    };

    /* IO_PAD_32 */
    pinctrl_flash_dq_2: flash_dq_2_in {
	    function = "flash_spi_dq_2";
        groups = "flash_spi_dq_2_grp";
    };

    /* IO_PAD_33 */
    pinctrl_flash_dq_3: flash_dq_3_in {
	    function = "flash_spi_dq_3";
        groups = "flash_spi_dq_3_grp";
    };

    /* IO_PAD_34 */
    pinctrl_flash_reset_n: flash_reset_n_out {
	    function = "flash_spi_reset_n_out";
        groups = "flash_spi_reset_n_out_grp";
    };

    /* IO_PAD_35 */
    pinctrl_flash_sclk: flash_sclk_out {
	    function = "flash_spi_sclk_out";
        groups = "flash_spi_sclk_out_grp";
    };

    /* IO_PAD_36 */
    pinctrl_pcie_wake_n: pcie_wake_n {
        function = "pcie_wake_n";
        groups = "pcie_wake_n_grp";
    };

    /* IO_PAD_37 */
    pinctrl_pcie_clkreq_n: pcie_clkreq_n {
        function = "pcie_clkreq_n";
        groups = "pcie_clkreq_n_grp";
    };

    /* IO_PAD_38 */
    pinctrl_pcie_perst_n_in: pcie_perst_n_in {
        function = "pcie_perst_n_in";
        groups = "pcie_perst_n_in_grp";
    };

    /* IO_PAD_39 */
    pinctrl_pcie_mperst_n_out: pcie_mperst_n_out {
        function = "pcie_mperst_n_out";
        groups = "pcie_mperst_n_out_grp";
    };

    /* IO_PAD_40 */
    pinctrl_SDIO0_DATA0_SDIO1_DATA4: SDIO0_DATA0_SDIO1_DATA4 {
        function = "SDIO0_DATA0_SDIO1_DATA4";
        groups = "SDIO0_DATA0_SDIO1_DATA4_grp";
    };

    /* IO_PAD_41 */
    pinctrl_SDIO0_DATA1_SDIO1_DATA5: SDIO0_DATA1_SDIO1_DATA5 {
        function = "SDIO0_DATA1_SDIO1_DATA5";
