        function = "uart0_rts_out";
        groups = "uart0_rts_out_4_grp";
    };

    /* IO_PAD_64 - GPIO_4 - In SBC, gpio 4 pin is serving as gpio function, and connected to sensor 0 for sensor 0 reset */
    pinctrl_gpio_4: gpio_4 {
        function = "gpio4";
        groups = "gpio4_3_grp";
    };

    /* IO_PAD_65 */
    pinctrl_gpio_5: gpio_5 {
